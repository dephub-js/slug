{
  "name": "@dephub/slug",
  "type": "module",
  "version": "1.0.4",
  "description": "URL-friendly slug generator with semantic comparison and validation",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "bin": {
    "slug": "./dist/cli.js"
  },
  "scripts": {
    "prepublishOnly": "pnpm lint && pnpm check && pnpm build",
    "release": "pnpm publish",
    "docs": "lineo md 'src/**/*.ts' --outFile code.md --outDir temp",
    "check": "tsc --noEmit --skipLibCheck",
    "lint": "eslint . --fix --max-warnings 0",
    "fmt": "prettier --write .",
    "clean": "rm -rf dist",
    "build": "vite build",
    "dev": "vite build -w --mode development"
  },
  "keywords": [
    "slug",
    "url",
    "seo",
    "string",
    "normalize",
    "comparison",
    "validation",
    "typescript",
    "nodejs",
    "dephub"
  ],
  "author": {
    "name": "Estarlin R",
    "email": "dev@estarlincito.com",
    "url": "https://estarlincito.com"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "license": "MIT",
  "homepage": "https://github.com/dephub-js/slug#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dephub-js/slug.git"
  },
  "bugs": {
    "url": "https://github.com/dephub-js/slug/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@dephub/command": "^2.0.0",
    "@dephub/logger": "^1.2.0"
  },
  "devDependencies": {
    "@dephub/eslint-ts": "^1.0.5",
    "@dephub/glob": "^1.0.2",
    "@dephub/path": "^1.0.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  }
}